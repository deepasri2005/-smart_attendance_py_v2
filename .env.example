# =====================================================
# Smart Attendance System — Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=your-very-secure-secret-key-change-this

# --- JWT ---
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-change-this

# --- Database ---
# Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_attendance

# --- Redis (for Celery + Rate Limiting) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Email (SMTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@smartattendance.com

# --- Timezone ---
TIMEZONE=Asia/Kolkata

# --- Face Recognition ---
FACE_RECOGNITION_TOLERANCE=0.5
FACE_DUPLICATE_COOLDOWN_MINUTES=10

# --- CCTV ---
CCTV_COOLDOWN_MINUTES=30
CCTV_FRAME_INTERVAL=30

# --- Geo-fence ---
GEO_DEFAULT_RADIUS_METERS=100
